POSTGRES_DB=kynakee
POSTGRES_USER=kynakee
POSTGRES_PASSWORD=change-me

ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080            # API internal port

AUTHENTICATION_SIGNING_KEY=    # Generate a secret of at least 32 bytes; shared by API and Gateway
AUTHENTICATION_ISSUER=Kynakee
AUTHENTICATION_AUDIENCE=KynakeeClients

IDENTITY_IDEMPOTENCY_HASH_KEY= # Independent stable Base64 32-byte secret
IDENTITY_IDEMPOTENCY_OUTCOME_KEY_V1= # Independent Base64 32-byte secret
IDENTITY_INVITATION_EMAIL_KEY_V1= # Independent Base64 32-byte secret
INVITATION_BASE_URL=http://localhost:3000/invitations/accept # Local frontend on this device only
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/auth/email/verify # Planned local frontend route; verify in kynakee-web
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_OAUTH_TENANT_ID=consumers
SMTP_OAUTH_CLIENT_ID= # Public client application ID
SMTP_OAUTH_USERNAME= # Personal mailbox; also From
SMTP_OAUTH_CACHE_KEY= # Independent Base64 32-byte secret
SMTP_OAUTH_CACHE_DIRECTORY= # Absolute existing private directory outside the repository

GATEWAY_RATE_LIMIT_PERMIT_LIMIT=100
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60


RABBITMQ_DEFAULT_USER=kynakee
RABBITMQ_DEFAULT_PASS=change-me

NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_INSPECTOR_PORT=4040

GATEWAY_HOST_PORT=8080
GATEWAY_HTTP_PORT=8080

POSTGRES_PORT=5432

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# SeaweedFS S3 (dev only; synthetic-access/synthetic-secret)
SEAWEEDFS_S3_PORT=8333
OBJECT_STORAGE_BUCKET=kynakee-media-dev
OBJECT_STORAGE_MAX_OBJECT_BYTES=104857600