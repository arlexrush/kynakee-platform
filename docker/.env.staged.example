# Staging environment configuration
# Copy to .env.staged and replace every placeholder before deployment.

ASPNETCORE_ENVIRONMENT=Staging

# Public hostname routed by Traefik and configured in DNS.
API_HOST=api.kynakee.com
ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=kynakee_staged
POSTGRES_USER=kynakee_staged
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_DEFAULT_USER=kynakee_staged
RABBITMQ_DEFAULT_PASS=change-me
