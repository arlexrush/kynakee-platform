# ═══════════════════════════════════════════════════════════════════════════════
# KYNAKEE PLATFORM — .env.staged.example
# Variables usadas en docker-compose.staged.yml (versión actual)
#
# INSTRUCCIONES:
#   1. cp .env.staged.example .env.staged
#   2. Rellena los valores
#   3. NUNCA subas .env.staged a git
# ═══════════════════════════════════════════════════════════════════════════════
 
# ── Traefik ───────────────────────────────────────────────────────────────────
# Usado en: traefik command --certificatesresolvers.letsencrypt.acme.email
ACME_EMAIL=devops@kynakee.com
 
# Usado en: traefik command --log.level=${TRAEFIK_LOG_LEVEL:-INFO}
TRAEFIK_LOG_LEVEL=INFO
 
# ── Dominios ──────────────────────────────────────────────────────────────────
# Usado en: kynakee-gateway labels → traefik.http.routers.gateway.rule=Host(`${API_HOST}`)
API_HOST=api.staging.kynakee.com
 
# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usado en: postgres environment + kynakee-api ConnectionStrings__DefaultConnection
POSTGRES_DB=kynakee_staged
POSTGRES_USER=kynakee
POSTGRES_PASSWORD=CHANGE_ME_staged_postgres_password

# ── Authentication (shared by Gateway and API) ───────────────────────────────
AUTHENTICATION_SIGNING_KEY=CHANGE_ME_with_a_random_secret_at_least_32_bytes
AUTHENTICATION_ISSUER=Kynakee
AUTHENTICATION_AUDIENCE=KynakeeClients

IDENTITY_IDEMPOTENCY_HASH_KEY= # Independent stable Base64 32-byte secret
IDENTITY_IDEMPOTENCY_OUTCOME_KEY_V1= # Independent Base64 32-byte secret
IDENTITY_INVITATION_EMAIL_KEY_V1= # Independent Base64 32-byte secret
INVITATION_BASE_URL=https://kynakee.com/invitations/accept # Planned route; use a separate staged host after it exists
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_OAUTH_TENANT_ID=consumers
SMTP_OAUTH_CLIENT_ID= # Public client application ID
SMTP_OAUTH_USERNAME= # Personal mailbox; also From
SMTP_OAUTH_CACHE_KEY= # Independent Base64 32-byte secret
SMTP_OAUTH_CACHE_DIRECTORY= # Absolute existing private staging directory outside the repository

GATEWAY_RATE_LIMIT_PERMIT_LIMIT=100
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
 
# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Usado en: rabbitmq environment + kynakee-api ConnectionStrings__RabbitMq
RABBITMQ_DEFAULT_USER=kynakee
RABBITMQ_DEFAULT_PASS=CHANGE_ME_staged_rabbitmq_password
# Object storage is disabled in the postponed staging environment.
