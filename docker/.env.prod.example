# ═══════════════════════════════════════════════════════════════════════════════
# KYNAKEE PLATFORM — .env.prod.example
# Variables usadas en docker-compose.prod.yml (versión actual)
#
# INSTRUCCIONES:
#   1. cp .env.prod.example .env.prod
#   2. Rellena los valores
#   3. NUNCA subas .env.prod a git
# ═══════════════════════════════════════════════════════════════════════════════
 
# ── Traefik ───────────────────────────────────────────────────────────────────
# Usado en: traefik command --certificatesresolvers.letsencrypt.acme.email
ACME_EMAIL=devops@kynakee.com
 
# Usado en: traefik command --log.level=${TRAEFIK_LOG_LEVEL:-WARN}
TRAEFIK_LOG_LEVEL=WARN
 
# ── Dominios ──────────────────────────────────────────────────────────────────
# Usado en: kynakee-gateway labels → traefik.http.routers.gateway.rule=Host(`${API_HOST}`)
API_HOST=api.kynakee.com
 
# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usado en: postgres environment + kynakee-api ConnectionStrings__DefaultConnection
POSTGRES_DB=kynakee_prod
POSTGRES_USER=kynakee
POSTGRES_PASSWORD=CHANGE_ME_strong_prod_postgres_password

# ── Authentication (shared by Gateway and API) ───────────────────────────────
AUTHENTICATION_SIGNING_KEY=CHANGE_ME_with_a_random_secret_at_least_32_bytes
AUTHENTICATION_ISSUER=Kynakee
AUTHENTICATION_AUDIENCE=KynakeeClients
GATEWAY_RATE_LIMIT_PERMIT_LIMIT=100
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
 
# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Usado en: rabbitmq environment + kynakee-api ConnectionStrings__RabbitMq
RABBITMQ_DEFAULT_USER=kynakee
RABBITMQ_DEFAULT_PASS=CHANGE_ME_strong_prod_rabbitmq_password
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=CHANGE_ME_prod_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_prod_minio_secret_key
MINIO_BUCKET=kynakee-media-prod
MINIO_USE_SSL=true
MINIO_MAX_OBJECT_BYTES=104857600
