# Production environment configuration
# Copy to .env.prod and replace every placeholder before deployment.

ASPNETCORE_ENVIRONMENT=Production

# Public hostname routed by Traefik and configured in DNS.
API_HOST=api.kynakee.com
ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=WARN

# PostgreSQL
POSTGRES_DB=kynakee_prod
POSTGRES_USER=kynakee_prod
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_DEFAULT_USER=kynakee_prod
RABBITMQ_DEFAULT_PASS=change-me
