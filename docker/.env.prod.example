# ═══════════════════════════════════════════════════════════════════════════════
# KYNAKEE PLATFORM — .env.prod.example
# Variables usadas en docker-compose.prod.yml (versión actual)
#
# INSTRUCCIONES:
#   1. cp .env.prod.example .env.prod
#   2. Rellena los valores
#   3. NUNCA subas .env.prod a git
# ═══════════════════════════════════════════════════════════════════════════════
 
# ── Traefik ───────────────────────────────────────────────────────────────────
# Usado en: traefik command --certificatesresolvers.letsencrypt.acme.email
ACME_EMAIL=devops@kynakee.com
 
# Usado en: traefik command --log.level=${TRAEFIK_LOG_LEVEL:-WARN}
TRAEFIK_LOG_LEVEL=WARN
 
# ── Dominios ──────────────────────────────────────────────────────────────────
# Usado en: kynakee-gateway labels → traefik.http.routers.gateway.rule=Host(`${API_HOST}`)
API_HOST=api.kynakee.com
 
# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usado en: postgres environment + kynakee-api ConnectionStrings__DefaultConnection
POSTGRES_DB=kynakee_prod
POSTGRES_USER=kynakee
POSTGRES_PASSWORD=CHANGE_ME_strong_prod_postgres_password

# ── Authentication (shared by Gateway and API) ───────────────────────────────
AUTHENTICATION_SIGNING_KEY=CHANGE_ME_with_a_random_secret_at_least_32_bytes
AUTHENTICATION_ISSUER=Kynakee
AUTHENTICATION_AUDIENCE=KynakeeClients

# ── Identity ─────────────────────────────────────────────────────────────────
IDENTITY_IDEMPOTENCY_HASH_KEY= # Independent stable Base64 32-byte secret
IDENTITY_IDEMPOTENCY_OUTCOME_KEY_V1= # Independent Base64 32-byte secret
IDENTITY_INVITATION_EMAIL_KEY_V1= # Independent Base64 32-byte secret
INVITATION_BASE_URL=https://kynakee.com/invitations/accept # Planned frontend route; deploy and verify before real invitations
EMAIL_VERIFICATION_BASE_URL= # HTTPS frontend verification page; configure before deployment
PASSWORD_RESET_BASE_URL= # HTTPS frontend password reset page; configure before deployment
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_OAUTH_TENANT_ID=consumers
SMTP_OAUTH_CLIENT_ID= # Public client application ID
SMTP_OAUTH_USERNAME= # Personal mailbox; also From
SMTP_OAUTH_CACHE_KEY= # Independent Base64 32-byte secret
SMTP_OAUTH_CACHE_DIRECTORY= # Absolute existing private production directory outside the repository

# ── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_RATE_LIMIT_PERMIT_LIMIT=100
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
 
# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Usado en: rabbitmq environment + kynakee-api ConnectionStrings__RabbitMq
RABBITMQ_DEFAULT_USER=kynakee
RABBITMQ_DEFAULT_PASS=CHANGE_ME_strong_prod_rabbitmq_password

# ── Object Storage ──────────────────────────────────────────────────────────
# Hetzner Object Storage; provision a private bucket separately
OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
OBJECT_STORAGE_REGION=fsn1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=kynakee-media-prod
OBJECT_STORAGE_MAX_OBJECT_BYTES=104857600