{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "identity-register": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/register", "Methods": ["POST"] }
      },
      "identity-login": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/login", "Methods": ["POST"] }
      },
      "identity-refresh": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/refresh", "Methods": ["POST"] }
      },
      "identity-logout": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/logout", "Methods": ["POST"] }
      },
      "identity-accept-invitation": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/invitations/accept", "Methods": ["POST"] }
      },
      "identity-verify-email": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/email/verify", "Methods": ["POST"] }
      },
      "identity-resend-email": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/email/resend", "Methods": ["POST"] }
      },
      "identity-forgot-password": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/password/forgot", "Methods": ["POST"] }
      },
      "identity-reset-password": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/auth/password/reset", "Methods": ["POST"] }
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  }
}
