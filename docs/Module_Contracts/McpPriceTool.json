{
  "name": "query_price",
  "description": "Returns a unit-price quote for the requested construction component, quantity, region, unit and currency. Does not place orders or perform payments.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "type": "object",
    "required": ["canonicalConceptId", "componentType", "category", "unit", "quantity", "geoRegion", "postalCode", "currency"],
    "properties": {
      "canonicalConceptId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
      "componentType": {"type": "string", "enum": ["Material", "Labor", "Equipment", "Subcontract", "Transport"]},
      "category": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
      "unit": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "\\S"},
      "quantity": {"type": "number", "exclusiveMinimum": 0},
      "geoRegion": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "\\S"},
      "postalCode": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "\\S"},
      "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["price", "unit", "currency", "confidence"],
    "properties": {
      "price": {"type": "number", "minimum": 0},
      "unit": {"type": "string", "minLength": 1, "maxLength": 20},
      "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
